# Copy to .env and fill in values as needed. Never commit .env.
# Example (no real secrets):
APP_NAME=Veyra API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://veyra:veyra@localhost:5432/veyra

# Development-only user identity (replaced by real authentication later).
DEV_USER_ID=dev-user

# Comma-separated CORS origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000